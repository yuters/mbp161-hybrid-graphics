#!/bin/sh
# Called from udev/systemd as root at amdgpu bind. Idempotent.
# DPM=low and ghost eDP off BEFORE any compositor. Do not start Hyprland.
set -eu
AMD=/sys/bus/pci/devices/0000:03:00.0
log() { echo "mbp161-hybrid-prep: $*" | tee /dev/kmsg >/dev/null 2>&1 || echo "mbp161-hybrid-prep: $*"; }

[ "$(id -u)" -eq 0 ] || { echo "root only" >&2; exit 1; }
# systemd may run this before amdgpu finishes probe. Wait; do not succeed early
# or SDDM/Hyprland can start with DPM=auto and hard-lock.
i=0
while [ ! -e "$AMD/power_dpm_force_performance_level" ]; do
	i=$((i + 1))
	[ "$i" -le 60 ] || { log "ABORT no DPM sysfs after 60s"; exit 1; }
	sleep 1
done

echo low > "$AMD/power_dpm_force_performance_level"
got=$(cat "$AMD/power_dpm_force_performance_level")
[ "$got" = "low" ] || { log "ABORT DPM=$got"; exit 1; }

AMD_CARD=
for c in /sys/class/drm/card[0-9]; do
	[ -e "$c/device/vendor" ] || continue
	[ "$(cat "$c/device/vendor")" = "0x1002" ] || continue
	AMD_CARD=$(basename "$c")
	break
done
[ -n "$AMD_CARD" ] || exit 0

for conn in /sys/class/drm/${AMD_CARD}-eDP-*; do
	[ -e "$conn/status" ] || continue
	echo off > "$conn/status" || true
done

heads=""
for conn in /sys/class/drm/${AMD_CARD}-DP-*; do
	[ -e "$conn/status" ] || continue
	heads="$heads $(basename "$conn")=$(cat "$conn/status")/$(cat "$conn/enabled")"
done
# Never write DPM=auto here. Hyprland + auto hard-locks.
{
	echo "armed=$(date -Is)"
	echo "boot_id=$(cat /proc/sys/kernel/random/boot_id)"
	echo "amd_card=$AMD_CARD"
	echo "dpm=low"
	echo "hyprland=$(pgrep -x Hyprland >/dev/null && echo yes || echo no)"
	echo "heads=$heads"
} > /run/mbp161-p1-armed
chmod 0644 /run/mbp161-p1-armed
log "DPM=low $AMD_CARD eDP off$heads"

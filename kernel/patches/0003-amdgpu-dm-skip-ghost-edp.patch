From: MacBookPro16,1 hybrid graphics
Subject: [PATCH 3/4] drm/amd/display: skip the internal eDP when it is muxed to the iGPU

After force_igd the internal eDP AUX belongs to the iGPU. Probing it from
amdgpu stalls on EDID, reports the connector as connected with no sink,
steals fb0, and blocks runtime idle -- the "ghost eDP". Skip detect, HPD,
polling and EDID reads for that link while the mux is on IGD. USB-C DP is
unaffected; its AUX is pinned to the discrete GPU.

diff --git i/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c w/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 941c1a312824..e2912a836b6a 100644
--- i/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ w/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -69,6 +69,7 @@
 
 #include "ivsrcid/ivsrcid_vislands30.h"
 
+#include <linux/apple-gmux.h>
 #include <linux/backlight.h>
 #include <linux/module.h>
 #include <linux/moduleparam.h>
@@ -1126,6 +1127,21 @@ static int dm_set_powergating_state(struct amdgpu_ip_block *ip_block,
 /* Prototypes of private functions */
 static int dm_early_init(struct amdgpu_ip_block *ip_block);
 
+/*
+ * Apple gmux dual-GPU: the internal eDP AUX follows the panel mux. After
+ * force_igd it points at the iGPU. Probing it from amdgpu waits on EDID,
+ * reports the connector connected with no sink, steals fb0, and blocks
+ * runtime idle. Skip that encoder while the mux is on IGD; USB-C DP is
+ * unaffected (external AUX is pinned to the dGPU).
+ */
+static bool amdgpu_dm_edp_muxed_away(const struct dc_link *link)
+{
+	if (!link || link->connector_signal != SIGNAL_TYPE_EDP)
+		return false;
+
+	return apple_gmux_panel_is_igd();
+}
+
 /* Allocate memory for FBC compressed data  */
 static void amdgpu_dm_fbc_init(struct drm_connector *connector)
 {
@@ -1637,6 +1653,9 @@ static void dm_handle_hpd_rx_offload_work(struct work_struct *work)
 
 	dc_link = aconnector->dc_link;
 
+	if (amdgpu_dm_edp_muxed_away(dc_link))
+		goto skip;
+
 	mutex_lock(&aconnector->hpd_lock);
 	if (!dc_link_detect_connection_type(dc_link, &new_connection_type))
 		drm_err(adev_to_drm(adev), "KMS: Failed to detect connector\n");
@@ -2147,6 +2166,9 @@ static int amdgpu_dm_init(struct amdgpu_device *adev)
 	if (amdgpu_dc_feature_mask & DC_FRL_MASK)
 		init_data.flags.enable_frl = true;
 
+	if (apple_gmux_panel_is_igd())
+		init_data.flags.edp_not_connected = true;
+
 	init_data.flags.seamless_boot_edp_requested = false;
 
 	if (amdgpu_device_seamless_boot_supported(adev)) {
@@ -4441,6 +4463,9 @@ static void handle_hpd_irq_helper(struct amdgpu_dm_connector *aconnector)
 	if (adev->dm.disable_hpd_irq)
 		return;
 
+	if (amdgpu_dm_edp_muxed_away(aconnector->dc_link))
+		return;
+
 	/*
 	 * In case of failure or MST no need to update connector status or notify the OS
 	 * since (for MST case) MST does this in its own context.
@@ -4572,6 +4597,9 @@ static void handle_hpd_rx_irq(void *param)
 	if (adev->dm.disable_hpd_irq)
 		return;
 
+	if (amdgpu_dm_edp_muxed_away(aconnector->dc_link))
+		return;
+
 	/*
 	 * TODO:Temporary add mutex to protect hpd interrupt not have a gpio
 	 * conflict, after implement i2c helper, this mutex should be
@@ -5913,6 +5941,13 @@ static int amdgpu_dm_initialize_drm_device(struct amdgpu_device *adev)
 			dm->hpd_rx_offload_wq[aconnector->base.index].aconnector =
 				aconnector;
 
+		if (amdgpu_dm_edp_muxed_away(link)) {
+			drm_info(adev_to_drm(adev),
+				 "Skipping eDP detect: gmux panel is owned by IGD\n");
+			amdgpu_set_panel_orientation(&aconnector->base);
+			continue;
+		}
+
 		if (!dc_link_detect_connection_type(link, &new_connection_type))
 			drm_err(adev_to_drm(adev), "KMS: Failed to detect connector\n");
 
@@ -7813,6 +7848,9 @@ amdgpu_dm_connector_poll(struct amdgpu_dm_connector *aconnector, bool force)
 	if (!force && link->local_sink && link->type == dc_connection_analog_load)
 		return connector->status;
 
+	if (amdgpu_dm_edp_muxed_away(link))
+		return connector_status_disconnected;
+
 	mutex_lock(&aconnector->hpd_lock);
 
 	if (dc_link_detect_connection_type(aconnector->dc_link, &conn_type) &&
@@ -8255,6 +8293,9 @@ static void amdgpu_dm_connector_funcs_force(struct drm_connector *connector)
 	struct i2c_adapter *ddc;
 	struct drm_device *dev = connector->dev;
 
+	if (amdgpu_dm_edp_muxed_away(dc_link))
+		return;
+
 	if (dc_link && dc_link->aux_mode)
 		ddc = &aconnector->dm_dp_aux.aux.ddc;
 	else
@@ -8314,6 +8355,9 @@ static void create_eml_sink(struct amdgpu_dm_connector *aconnector)
 	const struct edid *edid;
 	struct i2c_adapter *ddc;
 
+	if (amdgpu_dm_edp_muxed_away(dc_link))
+		return;
+
 	if (dc_link && dc_link->aux_mode)
 		ddc = &aconnector->dm_dp_aux.aux.ddc;
 	else
diff --git i/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c w/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
index 6be7f6edd0b2..c783f3da5320 100644
--- i/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
+++ w/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
@@ -28,6 +28,7 @@
 
 #include <linux/string.h>
 #include <linux/acpi.h>
+#include <linux/apple-gmux.h>
 #include <linux/i2c.h>
 
 #include <drm/drm_atomic.h>
@@ -1164,6 +1165,11 @@ enum dc_edid_status dm_helpers_read_local_edid(
 	const struct drm_edid *drm_edid;
 	const struct edid *edid;
 
+	/* gmux panel AUX is on the iGPU after force_igd; do not hammer eDP. */
+	if (link->connector_signal == SIGNAL_TYPE_EDP &&
+	    apple_gmux_panel_is_igd())
+		return EDID_BAD_INPUT;
+
 	if (link->aux_mode)
 		ddc = &aconnector->dm_dp_aux.aux.ddc;
 	else if (link->ddc_hw_inst == GPIO_DDC_LINE_UNKNOWN &&
@@ -1812,4 +1818,3 @@ void dm_helpers_mccs_vcp_set(struct dc_context *ctx, struct dc_link *link,
 		drm_dbg_driver(dev, "%s: Failed to set VCP code %d", __func__,
 				sink->edid_caps.freesync_vcp_code);
 }

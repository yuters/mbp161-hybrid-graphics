From: MacBookPro16,1 hybrid graphics
Subject: [PATCH 1/4] platform/x86: apple-gmux: switch the panel mux before DRM binds

Firmware POSTs MacBookPro16,1 with the internal panel muxed to the discrete
GPU. i915 then reads eDP DPCD down the inactive AUX, fails, and permanently
drops the panel -- a black internal display with nothing in the log.

Switch the mux to the iGPU during apple-gmux probe, while both DRM clients are
still held in -EPROBE_DEFER, and drop the firmware framebuffer before
gmux_switchto() so fbcon cannot adopt a stale scanout across the switch. That
ordering is the fix: with the mux moved but the old framebuffer still live, the
boot succeeded roughly 6 times in 9. With it, 26 consecutive clean boots.

Default the switch on for MacBookPro16,1 by DMI rather than requiring a command
line, while keeping apple_gmux.force_igd=0/1 authoritative when given.

Also export apple_gmux_panel_is_igd() so discrete GPU drivers can tell that the
internal panel is not theirs to drive; the eDP AUX follows the mux, so probing
it from the dGPU stalls on EDID and reports a phantom connected panel.

Requires apple-set-os so the iGPU is visible at 00:02.0.

--- i/drivers/platform/x86/apple-gmux.c
+++ w/drivers/platform/x86/apple-gmux.c
@@ -16,7 +16,9 @@
 #include <linux/backlight.h>
 #include <linux/acpi.h>
 #include <linux/pnp.h>
+#include <linux/aperture.h>
 #include <linux/apple-gmux.h>
+#include <linux/dmi.h>
 #include <linux/slab.h>
 #include <linux/delay.h>
 #include <linux/pci.h>
@@ -108,9 +110,47 @@
 
 # define MMIO_GMUX_MAX_BRIGHTNESS	0xffff
 
+/*
+ * force_igd: switch the panel mux to the iGPU at probe, before either DRM
+ * driver binds. Default-on for MacBookPro16,1; apple_gmux.force_igd=0/1
+ * overrides the DMI default.
+ *
+ * Firmware POSTs this machine with the mux on the dGPU. Without the switch,
+ * i915's eDP DPCD read goes down the inactive AUX and it permanently drops
+ * the panel. Requires apple-set-os so the iGPU is visible at 00:02.0.
+ */
 static bool force_igd;
-module_param(force_igd, bool, 0);
-MODULE_PARM_DESC(force_idg, "Switch gpu to igd on module load. Make sure that you have apple-set-os set up and the iGPU is in `lspci -s 00:02.0`. (default: false) (bool)");
+static bool force_igd_specified;
+
+static int param_set_force_igd(const char *val, const struct kernel_param *kp)
+{
+	force_igd_specified = true;
+	return param_set_bool(val, kp);
+}
+
+static const struct kernel_param_ops force_igd_ops = {
+	.set = param_set_force_igd,
+	.get = param_get_bool,
+};
+module_param_cb(force_igd, &force_igd_ops, &force_igd, 0);
+MODULE_PARM_DESC(force_igd, "Switch panel mux to IGD at probe (default: on for MacBookPro16,1)");
+
+static const struct dmi_system_id gmux_force_igd_dmi[] = {
+	{
+		.ident = "MacBookPro16,1",
+		.matches = {
+			DMI_MATCH(DMI_PRODUCT_NAME, "MacBookPro16,1"),
+		},
+	},
+	{ }
+};
+
+static bool gmux_should_force_igd(void)
+{
+	if (force_igd_specified)
+		return force_igd;
+	return dmi_check_system(gmux_force_igd_dmi);
+}
 
 static u8 gmux_pio_read8(struct apple_gmux_data *gmux_data, int port)
 {
@@ -455,6 +495,19 @@
 		gmux_data->switch_state_external = VGA_SWITCHEROO_DIS;
 }
 
+/*
+ * Discrete GPU drivers use this to tell that the internal panel is not theirs
+ * to drive: the eDP AUX follows the mux, so probing it from the dGPU stalls on
+ * EDID and reports a phantom connected panel.
+ */
+bool apple_gmux_panel_is_igd(void)
+{
+	if (!apple_gmux_data)
+		return false;
+	return apple_gmux_data->switch_state_display == VGA_SWITCHEROO_IGD;
+}
+EXPORT_SYMBOL_GPL(apple_gmux_panel_is_igd);
+
 static void gmux_write_switch_state(struct apple_gmux_data *gmux_data)
 {
 	if (gmux_data->switch_state_ddc == VGA_SWITCHEROO_IGD)
@@ -950,11 +1003,21 @@
 	gmux_enable_interrupts(gmux_data);
 	gmux_read_switch_state(gmux_data);
 
-	if (force_igd) {
+	if (gmux_should_force_igd()) {
 		struct pci_dev *pdev;
 
 		pdev = pci_get_domain_bus_and_slot(0, 0, PCI_DEVFN(2, 0));
 		if (pdev) {
+			/*
+			 * Both DRM clients are still deferred until the handler
+			 * is registered below. Remove the dGPU-programmed
+			 * firmware framebuffer before moving the mux so fbcon
+			 * cannot adopt a stale scanout, then release client
+			 * probing only after the panel and the VGA default both
+			 * point at the iGPU. Without this ordering the boot
+			 * succeeds roughly 6 times in 9.
+			 */
+			aperture_remove_all_conflicting_devices("apple-gmux");
 			pr_info("Switching to IGD");
 			gmux_switchto(VGA_SWITCHEROO_IGD);
 			vga_set_default_device(pdev);
diff --git c/include/linux/apple-gmux.h w/include/linux/apple-gmux.h
index 206d97ffda79..ccd8194492f0 100644
--- c/include/linux/apple-gmux.h
+++ w/include/linux/apple-gmux.h
@@ -163,6 +163,23 @@ static inline bool apple_gmux_present(void)
 	return acpi_dev_found(GMUX_ACPI_HID);
 }
 
+/**
+ * apple_gmux_panel_is_igd() - whether the internal panel mux points at the iGPU
+ *
+ * Valid after apple-gmux has probed. False if gmux is absent or unbound.
+ * Discrete GPU drivers must not probe, modeset, or advertise the internal
+ * eDP while this is true: AUX is on the iGPU and an EDID attempt stalls
+ * probe and reports a phantom connected panel.
+ */
+#if IS_REACHABLE(CONFIG_APPLE_GMUX)
+bool apple_gmux_panel_is_igd(void);
+#else
+static inline bool apple_gmux_panel_is_igd(void)
+{
+	return false;
+}
+#endif
+
 #else  /* !CONFIG_APPLE_GMUX */
 
 static inline bool apple_gmux_present(void)
@@ -175,6 +192,11 @@ static inline bool apple_gmux_detect(struct pnp_dev *pnp_dev, bool *indexed_ret)
 	return false;
 }
 
+static inline bool apple_gmux_panel_is_igd(void)
+{
+	return false;
+}
+
 #endif /* !CONFIG_APPLE_GMUX */
 
 #endif /* LINUX_APPLE_GMUX_H */

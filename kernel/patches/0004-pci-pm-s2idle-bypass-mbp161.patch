From: MacBookPro16,1 hybrid graphics
Subject: [PATCH 4/5] PCI/PM: leave the MacBookPro16,1 AMD functions untouched across s2idle

This machine cannot restore its Navi 14 SMU after the normal system-sleep
callbacks. The SMU returns -ETIME and every AMD DPM sysfs read then returns
-EBUSY for the rest of the boot.

Requesting PM-core direct-complete is not sufficient: it is advisory and is
discarded for runtime-active devices, which this topology deliberately keeps
the GPU as.

For suspend-to-idle only, on DMI product MacBookPro16,1, for the two AMD
functions 1002:7340 and 1002:ab38, leave the PCI function and its driver state
completely alone across prepare/suspend/late/noirq and the paired resume path.
Marking the immediate bridge skip_bus_pm propagates the requirement up the
hierarchy. Deep suspend and every other machine are unchanged.

The two Titan Ridge USB-C controllers were covered here as well until patch
0005 implemented Apple's native power sequence for them. They can be put back
under this bypass with mbp161_tb_bypass=1 mbp161_tb_type3=0, which restores the
older behaviour exactly.

diff --git i/drivers/pci/pci-driver.c w/drivers/pci/pci-driver.c
index f36778e62ac1..59e27461c19c 100644
--- i/drivers/pci/pci-driver.c
+++ w/drivers/pci/pci-driver.c
@@ -14,6 +14,7 @@
 #include <linux/sched.h>
 #include <linux/sched/isolation.h>
 #include <linux/cpu.h>
+#include <linux/dmi.h>
 #include <linux/pm_runtime.h>
 #include <linux/suspend.h>
 #include <linux/kexec.h>
@@ -736,12 +737,66 @@ static bool pci_has_legacy_pm_support(struct pci_dev *pci_dev)
 
 /* New power management framework */
 
+/*
+ * MacBookPro16,1 cannot restore its Navi14 SMU after the normal system-sleep
+ * callbacks.  The Titan Ridge USB-C controllers had the same symptom until the
+ * native Apple Type3 power sequence was implemented (see quirks.c); they are no
+ * longer covered here by default, but mbp161_tb_bypass can put them back.
+ * Requesting PM-core direct-complete is insufficient because it is advisory and
+ * is discarded for runtime-active devices and wakeup paths.
+ *
+ * For s2idle only, leave the affected PCI functions and their driver state
+ * completely untouched.  Keeping the immediate bridge in D0 propagates the
+ * requirement up the PCI hierarchy.  Deep suspend is deliberately unchanged.
+ */
+/*
+ * Whether the two Titan Ridge USB-C controllers are covered by this bypass as
+ * well as the AMD functions.  Off by default: they now take the real suspend
+ * path, driven through the native Apple Type3 sequence in quirks.c and the
+ * thunderbolt and xhci drivers, which lets them actually reach D3cold when
+ * idle instead of being pinned in D0.  Set mbp161_tb_bypass=1 together with
+ * mbp161_tb_type3=0 to fall back to the older pin-in-D0 behaviour.
+ */
+static bool mbp161_tb_bypass;
+core_param(mbp161_tb_bypass, mbp161_tb_bypass, bool, 0644);
+
+static bool pci_pm_mbp161_bypass_s2idle(struct pci_dev *pdev)
+{
+#if IS_ENABLED(CONFIG_SUSPEND)
+	bool affected;
+
+	if (pm_suspend_target_state != PM_SUSPEND_TO_IDLE)
+		return false;
+
+	affected = pdev->vendor == PCI_VENDOR_ID_ATI &&
+		   (pdev->device == 0x7340 || pdev->device == 0xab38);
+
+	if (mbp161_tb_bypass)
+		affected = affected ||
+			   (pdev->vendor == PCI_VENDOR_ID_INTEL &&
+			    (pdev->device == 0x15eb || pdev->device == 0x15ec));
+
+	return affected && dmi_match(DMI_PRODUCT_NAME, "MacBookPro16,1");
+#else
+	return false;
+#endif
+}
+
+static void pci_pm_mbp161_keep_bus_awake(struct pci_dev *pdev)
+{
+	pdev->skip_bus_pm = true;
+	if (pdev->bus->self)
+		pdev->bus->self->skip_bus_pm = true;
+}
+
 static int pci_pm_prepare(struct device *dev)
 {
 	struct pci_dev *pci_dev = to_pci_dev(dev);
 	const struct dev_pm_ops *pm = dev->driver ? dev->driver->pm : NULL;
 
 	dev_pm_set_strict_midlayer(dev, true);
+	if (pci_pm_mbp161_bypass_s2idle(pci_dev))
+		return 0;
 
 	if (pm && pm->prepare) {
 		int error = pm->prepare(dev);
@@ -766,6 +821,12 @@ static void pci_pm_complete(struct device *dev)
 {
 	struct pci_dev *pci_dev = to_pci_dev(dev);
 
+	if (pci_pm_mbp161_bypass_s2idle(pci_dev)) {
+		pci_dev->skip_bus_pm = false;
+		dev_pm_set_strict_midlayer(dev, false);
+		return;
+	}
+
 	pci_dev_complete_resume(pci_dev);
 	pm_generic_complete(dev);
 
@@ -814,6 +875,13 @@ static int pci_pm_suspend(struct device *dev)
 	struct pci_dev *pci_dev = to_pci_dev(dev);
 	const struct dev_pm_ops *pm = dev->driver ? dev->driver->pm : NULL;
 
+	if (pci_pm_mbp161_bypass_s2idle(pci_dev)) {
+		pci_pm_mbp161_keep_bus_awake(pci_dev);
+		dev_info(dev,
+			 "leaving PCI function untouched across s2idle on MacBookPro16,1\n");
+		return 0;
+	}
+
 	pci_dev->skip_bus_pm = false;
 
 	/*
@@ -872,6 +940,9 @@ static int pci_pm_suspend(struct device *dev)
 
 static int pci_pm_suspend_late(struct device *dev)
 {
+	if (pci_pm_mbp161_bypass_s2idle(to_pci_dev(dev)))
+		return 0;
+
 	if (dev_pm_skip_suspend(dev))
 		return 0;
 
@@ -885,6 +956,11 @@ static int pci_pm_suspend_noirq(struct device *dev)
 	struct pci_dev *pci_dev = to_pci_dev(dev);
 	const struct dev_pm_ops *pm = dev->driver ? dev->driver->pm : NULL;
 
+	if (pci_pm_mbp161_bypass_s2idle(pci_dev)) {
+		pci_pm_mbp161_keep_bus_awake(pci_dev);
+		return 0;
+	}
+
 	if (dev_pm_skip_suspend(dev))
 		return 0;
 
@@ -983,6 +1059,9 @@ static int pci_pm_resume_noirq(struct device *dev)
 	pci_power_t prev_state = pci_dev->current_state;
 	bool skip_bus_pm = pci_dev->skip_bus_pm;
 
+	if (pci_pm_mbp161_bypass_s2idle(pci_dev))
+		return 0;
+
 	if (dev_pm_skip_resume(dev))
 		return 0;
 
@@ -1012,6 +1091,9 @@ static int pci_pm_resume_noirq(struct device *dev)
 
 static int pci_pm_resume_early(struct device *dev)
 {
+	if (pci_pm_mbp161_bypass_s2idle(to_pci_dev(dev)))
+		return 0;
+
 	if (dev_pm_skip_resume(dev))
 		return 0;
 
@@ -1023,6 +1105,9 @@ static int pci_pm_resume(struct device *dev)
 	struct pci_dev *pci_dev = to_pci_dev(dev);
 	const struct dev_pm_ops *pm = dev->driver ? dev->driver->pm : NULL;
 
+	if (pci_pm_mbp161_bypass_s2idle(pci_dev))
+		return 0;
+
 	/*
 	 * This is necessary for the suspend error path in which resume is
 	 * called without restoring the standard config registers of the device.

+static int t2bce_freeze(struct device *dev)
+{
+    struct t2bce_device *bce = pci_get_drvdata(to_pci_dev(dev));
+    int status;
+
+    /*
+     * Freeze quiesces only; it must not tell bridgeOS to sleep. The system
+     * keeps running afterwards: the writer still has an image to write, and
+     * the image-loading kernel freezes again before handing over. The T2 is
+     * the power controller here, so a sleep handshake from a running host
+     * takes the machine down.
+     *
+     * Clients have already released their firmware queues from their
+     * hibernation PM notifiers, so only the command queues remain
+     * registered, with nothing posted for bridgeOS to write into.
+     */
+    pr_info("t2bce_core: freeze: entry\n");
+    mutex_lock(&bce->pm_lock);
+
+    bce->stateful_suspend_valid = false;
+    bce->no_state_fallback = false;
+    bce->no_state_resume = false;
+    t2bce_core_clients_pm_reset(bce);
+    status = t2bce_core_clients_pm_prepare(bce);
+    if (!status)
+        status = bce_pm_suspend_prepare(bce);
+    if (status)
+        bce_pm_suspend_abort(bce);
+
+    mutex_unlock(&bce->pm_lock);
+    pr_info("t2bce_core: freeze: exit status=%d\n", status);
+    return status;
+}
+
+static int t2bce_thaw(struct device *dev)
+{
+    struct t2bce_device *bce = pci_get_drvdata(to_pci_dev(dev));
+
+    /* Undo the freeze quiesce. No wake handshake: nothing was put to sleep. */
+    pr_info("t2bce_core: thaw: entry\n");
+    mutex_lock(&bce->pm_lock);
+
+    pci_set_master(bce->pci);
+    pci_set_master(bce->pci0);
+    bce_pm_resume_finish(bce);
+
+    mutex_unlock(&bce->pm_lock);
+    pr_info("t2bce_core: thaw: exit\n");
+    return 0;
+}
+
+static int t2bce_restore(struct device *dev)
+{
+    struct t2bce_device *bce = pci_get_drvdata(to_pci_dev(dev));
+    int status;
+
+    /*
+     * No saved firmware state can be restored here. The image-loading
+     * kernel signed on after this image was written, and a sign-on makes
+     * bridgeOS destroy every queue of the host owner, so the writer's
+     * queues are gone and only the loader's command queues remain.
+     * Stateful wake would then take bridgeOS's matching-nonce fast path
+     * and deserialize nothing. Sign on again, which drops the loader's
+     * queues, and register ours from a clean ring. Clients released their
+     * queues before the snapshot and rebuild them after thaw.
+     */
+    pr_info("t2bce_core: hibernate restore: re-sign-on\n");
+    mutex_lock(&bce->pm_lock);
+
+    bce->stateful_suspend_valid = false;
+    bce->no_state_fallback = false;
+    bce->no_state_resume = false;
+
+    pci_set_master(bce->pci);
+    pci_set_master(bce->pci0);
+
+    /* A new sign-on, as at probe: the XHCI PM doorbell comes first. */
+    bce_xhci_pm_start(&bce->xhci_pm, true);
+    bce_pm_channel_resume(bce);
+
+    status = bce_fw_version_handshake(bce);
+    if (status) {
+        pr_err("t2bce_core: hibernate restore: sign-on failed: %d\n", status);
+        goto out_unlock;
+    }
+    bce_reset_command_queues(bce);
+    status = bce_register_command_queues(bce);
+    if (status)
+        pr_err("t2bce_core: hibernate restore: command queue registration failed: %d\n", status);
+

+/*
+ * A sign-on proves bridgeOS dropped every host queue, including those kept in
+ * quarantine after a failed unregister: release them and their qids now.
+ * Until the command queues are registered again, nothing may be submitted.
+ */
+void t2bce_dma_transport_reset(struct t2bce_dma_engine *dma)
+{
+    struct bce_queue *q;
+    int qid, released = 0;
+
+    WRITE_ONCE(dma->revoked, true);
+    /* Completion dispatchers may still hold pointers taken before the reset. */
+    if (dma->ops && dma->ops->synchronize_completions)
+        dma->ops->synchronize_completions(dma->ops_userdata);
+    for (qid = 0; qid < BCE_MAX_QUEUE_COUNT; qid++) {
+        spin_lock(&dma->queues_lock);
+        q = dma->quarantined[qid];
+        dma->quarantined[qid] = NULL;
+        spin_unlock(&dma->queues_lock);
+        if (!q)
+            continue;
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,18,0)
+        ida_simple_remove(&dma->queue_ida, (uint) qid);
+#else
+        ida_free(&dma->queue_ida, (uint) qid);
+#endif
+        if (q->type == BCE_QUEUE_CQ)
+            t2bce_dma_free_cq(dma, (struct bce_queue_cq *) q);
+        else
+            t2bce_dma_free_sq(dma, (struct bce_queue_sq *) q);
+        released++;
+    }
+    WRITE_ONCE(dma->teardown_failed, false);
+    if (released)
+        pr_info("t2bce_dma: released %d quarantined queue(s) after sign-on\n", released);
+}
+EXPORT_SYMBOL_GPL(t2bce_dma_transport_reset);
+
+void t2bce_dma_transport_ready(struct t2bce_dma_engine *dma)
+{
+    WRITE_ONCE(dma->revoked, false);
+}

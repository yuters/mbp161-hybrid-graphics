@@ -932,6 +1002,239 @@
 };
 
 
+/*
+ * Hibernation cannot carry the BCE queues across: the image-loading kernel's
+ * sign-on destroys every queue this kernel registered (see t2bce_restore()).
+ * The card itself stays registered, as for any sound card across S4, so
+ * userspace never sees it leave and return: only the transport under it is
+ * released before the transition and rebuilt afterwards.
+ */
+static void t2audio_transport_suspend(struct t2audio_device *a)
+{
+    /*
+     * Streams go to SUSPENDED; userspace re-prepares them after resume. No
+     * D3hot here: this runs before the freezer, and a task waiting for D0 in
+     * snd_power_ref_and_wait() would block it. Commands fail with -ENODEV
+     * until the transport is back.
+     */
+    t2audio_quiesce(a, true);
+    t2audio_bce_destroy(a);
+    a->transport_down = true;
+}
+
+/* bridgeOS must still describe the devices the card was built from. */
+static int t2audio_verify_devices(struct t2audio_device *a)
+{
+    struct t2audio_msg buf = t2audio_reply_alloc();
+    struct t2audio_subdevice *sdev;
+    t2audio_device_id_t *dev_l;
+    u64 dev_cnt, i;
+    u64 uid_len;
+    char *uid;
+    int status;
+
+    status = t2audio_cmd_get_device_list(a, &buf, &dev_l, &dev_cnt);
+    if (status)
+        goto out;
+    if (dev_cnt != a->fw_dev_cnt) {
+        pr_warn("t2bce_audio: device count changed %llu -> %llu\n", a->fw_dev_cnt, dev_cnt);
+        status = -ESTALE;
+        goto out;
+    }
+    list_for_each_entry(sdev, &a->subdevice_list, list) {
+        for (i = 0; i < dev_cnt && dev_l[i] != sdev->dev_id; i++)
+            ;
+        if (i == dev_cnt) {
+            pr_warn("t2bce_audio: device %s (%llx) no longer listed\n", sdev->uid, sdev->dev_id);
+            status = -ESTALE;
+            goto out;
+        }
+    }
+    list_for_each_entry(sdev, &a->subdevice_list, list) {
+        status = t2audio_cmd_get_property(a, &buf, sdev->dev_id, sdev->dev_id,
+                T2AUDIO_PROP(T2AUDIO_PROP_SCOPE_GLOBAL, T2AUDIO_PROP_UID, 0),
+                NULL, 0, (void **) &uid, &uid_len);
+        if (status)
+            goto out;
+        if (uid_len != strlen(sdev->uid) || memcmp(uid, sdev->uid, uid_len)) {
+            pr_warn("t2bce_audio: device %llx is no longer %s\n", sdev->dev_id, sdev->uid);
+            status = -ESTALE;
+            goto out;
+        }
+    }
+out:
+    t2audio_reply_free(&buf);
+    return status;
+}
+
+/*
+ * Redo t2audio_init_bs() on the existing allocations: the output buffers the
+ * PCMs point at must be unchanged, and the host-side entries are written again.
+ */
+static int t2audio_rebind_bs(struct t2audio_device *a)
+{
+    DECLARE_BITMAP(seen, ARRAY_SIZE(a->bs->devices));
+    struct t2audio_buffer_struct_device *dev;
+    struct t2audio_buffer_struct_stream *bs_strm;
+    struct t2audio_subdevice *sdev;
+    struct t2audio_stream *strm;
+    size_t i, j, k, cnt;
+    int status;
+
+    if (ioread32(&a->reg_mem_gpr[0]) < 3 || ioread32(&a->reg_mem_gpr[1]) != T2AUDIO_SIG ||
+            ioread32(&a->reg_mem_gpr[2]) != a->bs_base || a->bs->signature != T2AUDIO_SIG) {
+        pr_warn("t2bce_audio: BufferStruct moved or invalid\n");
+        return -ESTALE;
+    }
+    bitmap_zero(seen, ARRAY_SIZE(a->bs->devices));
+    for (i = 0; i < a->bs->num_devices && i < ARRAY_SIZE(a->bs->devices); i++) {
+        dev = &a->bs->devices[i];
+        sdev = t2audio_find_dev_by_uid(a, dev->name);
+        if (!sdev)
+            continue;
+        if (sdev->buf_id != i)
+            return -ESTALE;
+        set_bit(i, seen);
+        dev->num_input_streams = 0;
+        for (j = 0; j < dev->num_output_streams && j < sdev->out_stream_cnt; j++) {
+            strm = &sdev->out_streams[j];
+            bs_strm = &dev->output_streams[j];
+            cnt = min_t(size_t, bs_strm->num_buffers, T2AUDIO_DEVICE_MAX_BUFFER_COUNT);
+            if (cnt != strm->buffer_cnt)
+                return -ESTALE;
+            for (k = 0; k < cnt; k++) {
+                if (strm->buffers[k].ptr != a->reg_mem_bs + bs_strm->buffers[k].address ||
+                        strm->buffers[k].size != bs_strm->buffers[k].size) {
+                    pr_warn("t2bce_audio: %s output buffer moved\n", sdev->uid);
+                    return -ESTALE;
+                }
+            }
+        }
+    }
+    list_for_each_entry(sdev, &a->subdevice_list, list) {
+        if (sdev->buf_id < ARRAY_SIZE(a->bs->devices) && test_bit(sdev->buf_id, seen))
+            continue;
+        if (sdev->buf_id != a->bs->num_devices || sdev->buf_id >= ARRAY_SIZE(a->bs->devices))
+            return -ESTALE;
+        strscpy(a->bs->devices[sdev->buf_id].name, sdev->uid,
+                sizeof(a->bs->devices[sdev->buf_id].name));
+        a->bs->devices[sdev->buf_id].num_input_streams = 0;
+        a->bs->devices[sdev->buf_id].num_output_streams = 0;
+        a->bs->num_devices++;
+    }
+    list_for_each_entry(sdev, &a->subdevice_list, list) {
+        if (sdev->in_stream_cnt != 1)
+            continue;
+        strm = &sdev->in_streams[0];
+        dev = &a->bs->devices[sdev->buf_id];
+        if (strm->buffer_cnt == 1 && strm->buffers[0].type == T2AUDIO_DMA_BUF_COHERENT) {
+            memset(strm->buffers[0].ptr, 0, strm->buffers[0].size);
+            dev->input_streams[0].buffers[0].address = strm->buffers[0].dma_addr;
+            dev->input_streams[0].buffers[0].size = strm->buffers[0].size;
+            dev->input_streams[0].num_buffers = 1;
+        }
+        dev->num_input_streams = 1;
+        wmb();
+        if ((status = t2audio_cmd_set_input_stream_address_ranges(a, sdev->dev_id)))
+            return status;
+    }
+    return 0;
+}
+
+static int t2audio_transport_resume(struct t2audio_device *a)
+{
+    struct t2audio_send_ctx sctx;
+    struct t2audio_subdevice *sdev;
+    int status;
+
+    down_write(&a->bcem.transport_sem);
+    status = t2audio_bce_init(a);
+    up_write(&a->bcem.transport_sem);
+    if (status)
+        return status;
+
+    reinit_completion(&a->remote_alive);
+    if ((status = t2audio_send(a, &sctx, 500, t2audio_msg_write_alive_notification, 1, 3)))
+        return status;
+    if (!wait_for_completion_timeout(&a->remote_alive, msecs_to_jiffies(500)))
+        return -ETIMEDOUT;
+    if ((status = t2audio_verify_devices(a)))
+        return status;
+    if ((status = t2audio_rebind_bs(a)))
+        return status;
+    list_for_each_entry(sdev, &a->subdevice_list, list) {
+        if (!sdev->jack)
+            continue;
+        t2audio_cmd_property_listener(a, sdev->dev_id, sdev->dev_id,
+                T2AUDIO_PROP(T2AUDIO_PROP_SCOPE_OUTPUT, T2AUDIO_PROP_JACK_PLUGGED, 0));
+        t2audio_handle_jack_connection_change(sdev);
+    }
+    if ((status = t2audio_cmd_set_remote_access(a, T2AUDIO_REMOTE_ACCESS_ON)))
+        return status;
+
+    a->transport_down = false;
+    a->pm_quiesced = false;
+    t2audio_reset_streams(a);
+    return 0;
+}
+
+static int t2audio_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+    struct t2audio_device *a;
+    struct pci_dev *pdev;
+    int status, ret;
+
+    mutex_lock(&t2audio_pm_lock);
+    switch (action) {
+    case PM_HIBERNATION_PREPARE:
+    case PM_RESTORE_PREPARE:
+        pdev = t2audio_bound_pdev;
+        if (!pdev || t2audio_detached_pdev)
+            break;
+        pci_dev_get(pdev);
+        t2audio_detached_pdev = pdev;
+        mutex_unlock(&t2audio_pm_lock);
+        device_lock(&pdev->dev);
+        a = pci_get_drvdata(pdev);
+        if (a)
+            t2audio_transport_suspend(a);
+        device_unlock(&pdev->dev);
+        pr_info("t2bce_audio: hibernation: transport released, card kept\n");
+        return NOTIFY_DONE;
+    case PM_POST_HIBERNATION:
+    case PM_POST_RESTORE:
+        pdev = t2audio_detached_pdev;
+        if (!pdev)
+            break;
+        t2audio_detached_pdev = NULL;
+        mutex_unlock(&t2audio_pm_lock);
+        device_lock(&pdev->dev);
+        a = pci_get_drvdata(pdev);
+        status = a ? t2audio_transport_resume(a) : -ENODEV;
+        device_unlock(&pdev->dev);
+        if (!a) {
+            pr_info("t2bce_audio: attach after hibernation: device was unbound meanwhile\n");
+        } else if (!status) {
+            pr_info("t2bce_audio: attach after hibernation: card kept, status=0\n");
+        } else {
+            /* Never run the card on firmware state that no longer matches it. */
+            pr_warn("t2bce_audio: attach after hibernation: rebuild failed (%d), re-probing\n", status);
+            device_release_driver(&pdev->dev);
+            ret = device_attach(&pdev->dev);
+            pr_info("t2bce_audio: attach after hibernation: %s (%d)\n",
+                    ret == 1 ? "bound" : "not bound", ret);
+        }
+        pci_dev_put(pdev);
+        return NOTIFY_DONE;
+    }
+    mutex_unlock(&t2audio_pm_lock);
+    return NOTIFY_DONE;
+}
+
+static struct notifier_block t2audio_pm_nb = {
+        .notifier_call = t2audio_pm_notify,
+};
+
 static int __init t2audio_module_init(void)
 {
     int result;
@@ -950,6 +1253,7 @@
     result = pci_register_driver(&t2audio_pci_driver);
     if (result)
         goto fail_drv;
+    register_pm_notifier(&t2audio_pm_nb);
     pr_info("t2bce_audio: module initialized\n");
     return 0;
 
@@ -967,6 +1271,13 @@
 
 static void __exit t2audio_module_exit(void)
 {
+    unregister_pm_notifier(&t2audio_pm_nb);
+    mutex_lock(&t2audio_pm_lock);
+    if (t2audio_detached_pdev) {
+        pci_dev_put(t2audio_detached_pdev);
+        t2audio_detached_pdev = NULL;
+    }
+    mutex_unlock(&t2audio_pm_lock);
     pci_unregister_driver(&t2audio_pci_driver);
     class_destroy(t2audio_class);
     unregister_chrdev_region(t2audio_chrdev, 1);
diff -ruN a/drivers/staging/t2bce/t2bce_audio/audio.h b/drivers/staging/t2bce/t2bce_audio/audio.h
--- a/drivers/staging/t2bce/t2bce_audio/audio.h
+++ b/drivers/staging/t2bce/t2bce_audio/audio.h
@@ -90,6 +90,9 @@
     snd_pcm_uframes_t bridge_pos;

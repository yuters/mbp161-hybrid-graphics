     if (a->bs->signature != T2AUDIO_SIG) {
         dev_err(a->dev, "t2bce_audio: Bad BufferStruct sig (%x)", a->bs->signature);
@@ -866,10 +933,13 @@
      * is not possible when we are in the reply parsing code's context. */
     struct t2audio_prop_change_work_struct *work;

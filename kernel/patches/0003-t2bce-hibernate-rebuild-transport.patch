+/*
+ * Hibernation cannot carry bridgeOS state across. The image-loading kernel
+ * signs on as the same host owner, which destroys every queue this kernel had
+ * registered (see t2bce_restore()). Release everything bridgeOS holds for this
+ * HCD while the firmware and usbcore are both fully running, and build it again
+ * from scratch afterwards, as native macOS does after a controller identity
+ * change. Posted event and transfer buffers are DMA targets; none may survive
+ * into the snapshot or into the image-loading kernel's memory handoff.
+ */
+static void bce_vhci_detach(struct bce_vhci *vhci, const char *reason)
+{
+    if (vhci->detached)
+        return;
+
+    pr_info("t2bce_vhci: detach for %s: entry\n", reason);
+    cancel_work_sync(&vhci->w_add_hcd);
+    /* Stops the controller and destroys all device transfer queues. */
+    bce_vhci_remove_hcd(vhci);
+    usb_put_hcd(vhci->hcd);
+    vhci->hcd = NULL;
+    flush_workqueue(vhci->tq_state_wq);
+    bce_vhci_destroy_event_queues(vhci);
+    bce_vhci_destroy_message_queues(vhci);
+    vhci->port_change_pending = 0;
+    WRITE_ONCE(vhci->system_suspending, false);
+    vhci->no_state_resume = false;
+    vhci->detached = true;
+    pr_info("t2bce_vhci: detach for %s: exit\n", reason);
+}
+
+static int bce_vhci_attach(struct bce_vhci *vhci, const char *reason)
+{
+    int status;
+
+    if (!vhci->detached)
+        return 0;
+
+    pr_info("t2bce_vhci: attach after %s: entry\n", reason);
+    if ((status = bce_vhci_create_message_queues(vhci)))
+        goto fail;
+    if ((status = bce_vhci_create_event_queues(vhci)))
+        goto fail_mq;
+    vhci->hcd = bce_vhci_alloc_hcd(vhci);
+    if (!vhci->hcd) {
+        status = -ENOMEM;
+        goto fail_eq;
+    }
+    if ((status = __bce_vhci_add_hcd(vhci))) {
+        usb_put_hcd(vhci->hcd);
+        vhci->hcd = NULL;
+        goto fail_eq;
+    }
+    vhci->detached = false;
+    pr_info("t2bce_vhci: attach after %s: exit status=0\n", reason);
+    return 0;
+
+fail_eq:
+    bce_vhci_destroy_event_queues(vhci);
+fail_mq:
+    bce_vhci_destroy_message_queues(vhci);
+fail:
+    pr_err("t2bce_vhci: attach after %s failed: %d\n", reason, status);
+    return status;
+}
+
+static int bce_vhci_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+    struct bce_vhci *vhci = container_of(nb, struct bce_vhci, pm_nb);
+
+    /*
+     * These run before tasks are frozen and after they are thawed, in the
+     * writer (hibernation) and in the image-loading kernel (restore). The
+     * restored kernel continues from the writer's PM_POST_HIBERNATION.
+     */
+    switch (action) {
+    case PM_HIBERNATION_PREPARE:
+        bce_vhci_detach(vhci, "hibernation");
+        break;
+    case PM_RESTORE_PREPARE:
+        bce_vhci_detach(vhci, "image restore");
+        break;
+    case PM_POST_HIBERNATION:
+        bce_vhci_attach(vhci, "hibernation");
+        break;
+    case PM_POST_RESTORE:
+        bce_vhci_attach(vhci, "failed image restore");
+        break;
+    }
+    return NOTIFY_DONE;
+}

+static void t2audio_bce_queue_destroy(struct t2audio_device *dev, struct t2audio_bce_queue *q)
+{
+    if (!q->sq)
+        return;
+    /* Unregister first: bridgeOS may still own posted receive buffers. */
+    t2bce_core_destroy_sq(dev->bce, q->sq);
+    q->sq = NULL;
+}
+
+/*
+ * Release every queue bridgeOS holds for this device. Once the SQs are
+ * unregistered no new completion can target them; wait out a completion
+ * handler that is already running before freeing the buffers it reads.
+ */
+void t2audio_bce_destroy(struct t2audio_device *dev)
+{
+    struct t2audio_bce *b = &dev->bcem;
+    struct t2audio_bce_queue *queues[] = { &b->qin, &b->qout };
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(queues); i++)
+        t2audio_bce_queue_destroy(dev, queues[i]);
+    t2bce_core_synchronize_completions(dev->bce);
+    for (i = 0; i < ARRAY_SIZE(queues); i++) {
+        if (!queues[i]->data)
+            continue;
+        dma_free_coherent(t2bce_core_client_dma_dev(dev->bce),
+                queues[i]->el_size * queues[i]->el_count,
+                queues[i]->data, queues[i]->dma_addr);
+        queues[i]->data = NULL;
+    }
+    if (b->cq) {
+        t2bce_core_destroy_cq(dev->bce, b->cq);
+        b->cq = NULL;
+    }
+    if (dev->msg_wq)
+        drain_workqueue(dev->msg_wq);
+}
+
 int t2audio_bce_queue_init(struct t2audio_device *dev, struct t2audio_bce_queue *q, const char *name,

+/*
+ * Hibernation cannot carry bridgeOS state across: the image-loading kernel's
+ * sign-on destroys every queue this kernel registered (see t2bce_restore()).
+ * Unbind before the transition, which releases the firmware queues while
+ * everything still runs, and probe again afterwards on the rebuilt transport.
+ */
+static int t2audio_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+    struct pci_dev *pdev;
+    int ret;
+
+    mutex_lock(&t2audio_pm_lock);
+    switch (action) {
+    case PM_HIBERNATION_PREPARE:
+    case PM_RESTORE_PREPARE:
+        pdev = t2audio_bound_pdev;
+        if (!pdev || t2audio_detached_pdev)
+            break;
+        pci_dev_get(pdev);
+        t2audio_detached_pdev = pdev;
+        mutex_unlock(&t2audio_pm_lock);
+        pr_info("t2bce_audio: detach for hibernation\n");
+        device_release_driver(&pdev->dev);
+        pr_info("t2bce_audio: detach done\n");
+        return NOTIFY_DONE;
+    case PM_POST_HIBERNATION:
+    case PM_POST_RESTORE:
+        pdev = t2audio_detached_pdev;
+        if (!pdev)
+            break;
+        t2audio_detached_pdev = NULL;
+        mutex_unlock(&t2audio_pm_lock);
+        ret = device_attach(&pdev->dev);
+        pr_info("t2bce_audio: attach after hibernation: %s (%d)\n",
+                ret == 1 ? "bound" : "not bound", ret);
+        pci_dev_put(pdev);
+        return NOTIFY_DONE;
+    }
+    mutex_unlock(&t2audio_pm_lock);
+    return NOTIFY_DONE;
+}
+
+static struct notifier_block t2audio_pm_nb = {
+        .notifier_call = t2audio_pm_notify,
+};

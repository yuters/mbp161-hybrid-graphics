+
+/*
+ * Hot-unplug model, as snd-usb-audio does it: remove() must not wait for
+ * applications to close the card. It is also called from the hibernation PM
+ * notifier, after systemd-sleep has frozen user.slice; a frozen PipeWire
+ * cannot close anything, so snd_card_free() there would never return.
+ */
+static void t2audio_remove(struct pci_dev *dev)
+{
+    struct t2audio_device *t2audio = pci_get_drvdata(dev);
+
+    mutex_lock(&t2audio_pm_lock);
+    if (t2audio_bound_pdev == dev)
+        t2audio_bound_pdev = NULL;
+    mutex_unlock(&t2audio_pm_lock);
+
+    /* Stop IO and revoke remote access while the transport still exists. */
+    t2audio_quiesce(t2audio, false);
+    cancel_work_sync(&t2audio->resume_work);
+    debugfs_remove_recursive(t2audio->debugfs_dir);
+    t2audio->debugfs_dir = NULL;
+    /* Stops running streams and fails further file operations; no wait for close. */
+    snd_card_disconnect(t2audio->card);
+    /* Previously leaked: registered queues with receive buffers posted. */
+    t2audio_bce_destroy(t2audio);
+    destroy_workqueue(t2audio->msg_wq);
+    t2audio->msg_wq = NULL;
     device_destroy(t2audio_class, t2audio->devt);
+    t2bce_core_client_set_resume_complete_callback(t2audio->bce, NULL, NULL);
+    t2bce_core_client_set_pm_ops(t2audio->bce, NULL, NULL);
+    t2bce_core_client_put(t2audio->bce);
+    t2audio->bce = NULL;
     pci_free_irq_vectors(dev);
     pci_release_regions(dev);
     pci_disable_device(dev);
-    t2bce_core_client_set_pm_ops(t2audio->bce, NULL, NULL);
-    t2bce_core_client_put(t2audio->bce);
-    kfree(t2audio);
+    pci_set_drvdata(dev, NULL);
+    snd_card_free_when_closed(t2audio->card);
 }
 
 static int t2audio_quiesce(struct t2audio_device *t2audio, bool suspend_pcm)
@@ -227,7 +289,13 @@

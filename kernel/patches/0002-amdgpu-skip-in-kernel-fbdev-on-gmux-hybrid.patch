From: MacBookPro16,1 hybrid graphics
Subject: [PATCH 2/4] drm/amdgpu: skip in-kernel fbdev when the gmux panel is on the iGPU

With the internal panel muxed to the iGPU, letting amdgpu's in-kernel fbdev
modeset the discrete GPU's outputs lights the external display on a TTY and
blocks runtime idle. The compositor owns those outputs instead. i915 still
gets fbdev for the internal panel.

apple_gmux_panel_is_igd() is false unless apple-gmux is bound and the mux
actually points at the iGPU, so this is inert on every other machine.

diff --git i/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c w/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index 29f8be70f2d5..bac4cc8bce8c 100644
--- i/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ w/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -32,6 +32,7 @@
 #include <drm/drm_probe_helper.h>
 #include <drm/drm_vblank.h>
 
+#include <linux/apple-gmux.h>
 #include <linux/cc_platform.h>
 #include <linux/console.h>
 #include <linux/dynamic_debug.h>
@@ -2469,8 +2470,16 @@ static int amdgpu_pci_probe(struct pci_dev *pdev,
 	/*
 	 * 1. don't init fbdev on hw without DCE
 	 * 2. don't init fbdev if there are no connectors
+	 * 3. on an Apple gmux hybrid with the panel muxed to the iGPU, do not
+	 *    let in-kernel fbdev modeset the discrete GPU's outputs. That lights
+	 *    the external display on a TTY and blocks runtime idle; the
+	 *    compositor owns those outputs instead. i915 still gets fbdev for
+	 *    the internal panel.
 	 */
-	if (adev->mode_info.mode_config_initialized &&
+	if (apple_gmux_panel_is_igd()) {
+		drm_info(adev_to_drm(adev),
+			 "Skipping in-kernel fbdev: gmux panel on IGD, compositor owns KMS\n");
+	} else if (adev->mode_info.mode_config_initialized &&
 	    !list_empty(&adev_to_drm(adev)->mode_config.connector_list)) {
 		const struct drm_format_info *format;
 
